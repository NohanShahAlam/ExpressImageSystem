<h1>{{title}}</h1>
<form action="uploadImages" method="post" enctype="multipart/form-data">
    <label for="image1">Input your first image: </label>
    <input type="file" id="image1" name="image" required>
    <br>
    <label for="image2">Input your second image: </label>
    <input type="file" id="image2" name="image" required>
    <br><br>
    <button type="submit">Send</button>
</form>
